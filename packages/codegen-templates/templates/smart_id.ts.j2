// Generated by mcpgen — Stage E Phase 3 (runtime/smart_id.ts).
//
// Smart ID format: {server}:{type}:{collection}:{identifier}
//
// Pass 1 derives the canonical four-part smart-ID format from
// `RoutingConfig.SmartIdSchema`. Per-tool handlers parse incoming `id`
// arguments via `parseSmartId` and use the parts to route the upstream call.
// `makeSmartId` round-trips for response shaping.
//
// Identifier (last segment) may contain colons (Stripe charges look like
// `ch_3O5jJ2...`); the regex uses `(.+)` for the trailing capture so colons
// in the identifier round-trip cleanly.

const _SMART_ID_REGEX = /^([^:]+):([^:]+):([^:]+):(.+)$/;

export interface SmartIdParts {
  readonly server: string;
  readonly type: string;
  readonly collection: string;
  readonly identifier: string;
}

/**
 * Parses a smart ID into its four parts. Throws a teaching error message
 * (per CONTEXT D-32) when the format is wrong — the agent learns the
 * canonical shape AND the recovery path (`search()` first).
 */
export function parseSmartId(id: string): SmartIdParts {
  const m = id.match(_SMART_ID_REGEX);
  if (!m) {
    throw new Error(
      "Invalid smart ID format. Expected `{server}:{type}:{collection}:{identifier}`. " +
        "Use search() to find a valid ID.",
    );
  }
  return {
    server: m[1] as string,
    type: m[2] as string,
    collection: m[3] as string,
    identifier: m[4] as string,
  };
}

/** Round-trip builder — serialises four-part smart ID. */
export function makeSmartId(parts: SmartIdParts): string {
  return `${parts.server}:${parts.type}:${parts.collection}:${parts.identifier}`;
}
