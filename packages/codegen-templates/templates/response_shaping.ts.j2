// Generated by mcpgen — Stage E Phase 3 (runtime/response_shaping.ts).
//
// Pass 5 field-filter runtime + capability-gated structuredContent assembly.
//
// `applyFieldFilter` implements the always-include / opt-in / always-exclude
// split per Pass 5 design §1.3. Caller passes:
//   - `alwaysInclude`: fields baked into the tool config at codegen time.
//   - `optInRequested`: fields the agent explicitly asked for via the
//     `properties` parameter (universal list_objects + fetch tools).
// Empty alwaysInclude AND optInRequested → pass-through (older clients +
// fetch with `properties=['*']`).
//
// `assembleStructuredContent` gates `structuredContent` on the client
// `protocolVersion` per Pitfall #4 (CONTEXT D-24). Older clients receive
// `content`-only; newer clients receive both `content` and `structuredContent`.

import { gateOutputSchema } from "./capability.js";

/**
 * Filter top-level fields of a response object per the Pass 5 split.
 *
 * v1 contract: top-level field selection only — nested-field selection
 * (e.g., `customer.email`) is a Phase 9 follow-up. The `properties` arg
 * convention `['*']` means "include all fields" (pass-through).
 */
export function applyFieldFilter(
  data: unknown,
  alwaysInclude: readonly string[],
  optInRequested: readonly string[],
): unknown {
  if (data === null || typeof data !== "object") return data;
  if (Array.isArray(data)) {
    return data.map((row) => applyFieldFilter(row, alwaysInclude, optInRequested));
  }
  // Pass-through when both lists are empty (no field-filter config).
  if (alwaysInclude.length === 0 && optInRequested.length === 0) return data;
  // `*` opt-in = include everything.
  if (optInRequested.includes("*") || alwaysInclude.includes("*")) return data;
  const obj = data as Record<string, unknown>;
  const allowed = new Set<string>([...alwaysInclude, ...optInRequested]);
  const out: Record<string, unknown> = {};
  for (const k of Object.keys(obj)) {
    if (allowed.has(k)) out[k] = obj[k];
  }
  return out;
}

// Mutable shape required by the SDK's CallToolResult schema; the SDK's Zod
// `tool()` callback signature expects mutable `content[]` AND the SDK
// `CallToolResultSchema` is defined with `z.object({...}).$loose` which
// adds an `[x: string]: unknown` index signature. We mirror the index
// signature so structural assignment to the SDK callback's return type
// succeeds without an explicit cast.
export interface McpDualResult {
  [k: string]: unknown;
  content: Array<{ type: "text"; text: string }>;
  // SDK CallToolResultSchema declares structuredContent as
  // `{ [x: string]: unknown } | undefined` (object with arbitrary
  // string-keyed values, NOT plain `unknown`), so we mirror that shape
  // and let callers pass through any object/record-like value.
  structuredContent?: { [k: string]: unknown };
}

/**
 * Assemble the dual `content` + `structuredContent` MCP response.
 *
 * Capability-gated per Pitfall #4: clients with `protocolVersion <
 * 2025-06-18` receive `content`-only — older clients reject unknown
 * `structuredContent` field and silently fail to load tools.
 */
export function assembleStructuredContent(
  data: unknown,
  clientVersion: string | undefined,
): McpDualResult {
  const text = JSON.stringify(data);
  if (gateOutputSchema(clientVersion)) {
    // Cast: callers pass arbitrary upstream payloads here; we re-type as
    // a record so the result matches the SDK's
    // `structuredContent?: { [x: string]: unknown }` shape. Non-object
    // upstream payloads are wrapped in `{ value }` to keep the contract.
    const structured: { [k: string]: unknown } =
      data !== null && typeof data === "object" && !Array.isArray(data)
        ? (data as { [k: string]: unknown })
        : { value: data };
    return {
      content: [{ type: "text", text }],
      structuredContent: structured,
    };
  }
  return { content: [{ type: "text", text }] };
}
