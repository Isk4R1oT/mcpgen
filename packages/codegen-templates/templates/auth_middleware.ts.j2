//                  Open-Meteo, NWS); middleware MUST NOT demand
//                  X-Upstream-Auth or it 400s every request.

import { ALLOWED_HOSTS } from "../config.js";
{% if auth_mode == "oauth" %}
import { OAuthProvider } from "@cloudflare/workers-oauth-provider";
{% elif auth_mode == "stored" %}
import { decryptCredential } from "./credentials.js";
{% endif %}

export interface AuthContext {
  readonly upstreamCredential: string;
  readonly clientVersion?: string;
}

export interface AuthResult {
  readonly ctx?: AuthContext;
  readonly response?: Response;
}

{% if auth_mode == "passthrough" %}
// Passthrough mode (CONTEXT D-21 + RESEARCH Code Example 8).
// Tenant key validation lives in the dispatch Worker; this middleware
// extracts the upstream credential the MCP client forwards in
// X-Upstream-Auth. The credential is NEVER persisted (T-04-09-passthrough-
// creds-persist mitigation; verified by passthrough no-persist grep).

export interface AuthEnv {
  // Phase 6 binds tenant-routing config; Phase 4 only needs the type surface.
  readonly ALLOWED_HOSTS_CHECK?: typeof ALLOWED_HOSTS;
}

export async function authMiddleware(req: Request, _env: AuthEnv): Promise<AuthResult> {
  const tenantKey = req.headers.get("Authorization")?.replace(/^Bearer\s+/, "");
  if (!tenantKey) {
    return { response: new Response("Unauthorized: tenant key missing", { status: 401 }) };
  }
  const upstream = req.headers.get("X-Upstream-Auth");
  if (!upstream) {
    return {
      response: new Response(
        JSON.stringify({
          error:
            "Missing X-Upstream-Auth header. Configure your MCP client to forward " +
            "upstream credentials. See server README for setup.",
        }),
        { status: 400, headers: { "content-type": "application/json" } },
      ),
    };
  }
  return { ctx: { upstreamCredential: upstream } };
}
{% elif auth_mode == "stored" %}
// Stored mode (CONTEXT D-21).
// Per-tenant DEK lookup at request time; AES-256-GCM helpers live in
// auth/credentials.ts. Phase 6 wires the actual TENANT_DEK_KV binding +
// deploy-time DEK provisioning. Phase 4 emits the template surface.

export interface AuthEnv {
  readonly TENANT_DEK_KV: KVNamespace;
  // Belt-and-suspenders typing: ALLOWED_HOSTS is consumed by the SDK
  // transport in src/server.ts; we re-import here so a future regression in
  // the transport surface still fails closed at the auth boundary.
  readonly ALLOWED_HOSTS_CHECK?: typeof ALLOWED_HOSTS;
}

export async function authMiddleware(req: Request, env: Env): Promise<AuthResult> {
  const tenantKey = req.headers.get("Authorization")?.replace(/^Bearer\s+/, "");
  if (!tenantKey) {
    return { response: new Response("Unauthorized: tenant key missing", { status: 401 }) };
  }
  const dekRaw = await env.TENANT_DEK_KV.get(tenantKey, "arrayBuffer");
  if (!dekRaw) {
    return { response: new Response("Tenant DEK missing", { status: 403 }) };
  }
  const stored = await env.TENANT_DEK_KV.get(`${tenantKey}:upstream`);
  if (!stored) {
    return { response: new Response("Upstream credential not stored", { status: 400 }) };
  }
  const upstream = await decryptCredential(stored, dekRaw);
  return { ctx: { upstreamCredential: upstream } };
}
