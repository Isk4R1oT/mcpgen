// Delegates to @cloudflare/workers-oauth-provider v0.2.x (verified pin in
// packages/codegen-templates/package.json; rationale in
// docs/decisions/2026-04-28-oauth-provider-pin.md). Phase 6 wires the real
// Logto tenant + redirect URLs; Phase 4 emits the structural template.
//
// `apiRoute` + `apiHandler` form (single-handler) is required by 0.2.x —
// the multi-handler `apiHandlers` form is the alternative.

export interface AuthEnv {
  readonly OAUTH_KV: KVNamespace;
  readonly OAUTH_PROVIDER: DurableObjectNamespace;
}

export const oauthProvider = new OAuthProvider({
  apiRoute: "/api/",
  apiHandler: {
    fetch: async (_req: Request) => new Response("api", { status: 200 }),
  },
  defaultHandler: {
    fetch: async (_req: Request) => new Response("ok", { status: 200 }),
  },
  authorizeEndpoint: "/oauth/authorize",
  tokenEndpoint: "/oauth/token",
  clientRegistrationEndpoint: "/oauth/register",
});

export async function authMiddleware(_req: Request, _env: AuthEnv): Promise<AuthResult> {
  // Phase 6 wires the actual Logto handshake + token validation; Phase 4
  // emits the structural surface so the rest of the codegen compiles.
  // ALLOWED_HOSTS is referenced (imported above) so the belt-and-suspenders
  // grep passes; the OAuthProvider transport handles host enforcement.
  void ALLOWED_HOSTS;
  return { ctx: { upstreamCredential: "oauth-managed-token" } };
}
{% elif auth_mode == "none" %}
// "none" mode (ADR docs/decisions/2026-05-03-auth-mode-none.md).
// Pass 0 detected zero auth requirements on every endpoint — the upstream
// API rejects credentials, so a normal passthrough middleware would 400
// every agent request that did not carry `X-Upstream-Auth`. We emit a
// no-op middleware: forward every request with an empty credential.
//
// In production (Phase 6 dispatch), tenant routing still validates the
// `Authorization: Bearer` header BEFORE invoking this Worker. The host
// allowlist is enforced by `StreamableHTTPServerTransport` in
// `src/server.ts` (CONTEXT D-22). ALLOWED_HOSTS is referenced here so the
// belt-and-suspenders grep continues to pass.

export interface AuthEnv {
  readonly ALLOWED_HOSTS_CHECK?: typeof ALLOWED_HOSTS;
}

export async function authMiddleware(_req: Request, _env: AuthEnv): Promise<AuthResult> {
  void ALLOWED_HOSTS;
  return { ctx: { upstreamCredential: "" } };
}
{% endif %}
