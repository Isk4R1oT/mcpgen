// `ErrorEvent` (NOT the broader `Event`) per CloudflareOptions.
import type { ErrorEvent, EventHint } from "@sentry/cloudflare";

// Phase 9 D-03 convergence: 7 universal auth headers (lowercase, compared
// case-insensitively).
const REDACT_HEADERS = new Set<string>([
  "authorization",
  "x-upstream-auth",
  "cookie",
  "set-cookie",
  "stripe-account",
  "stripe-signature",
  "x-webhook-signature",
{% for h in auth_headers %}
  "{{ h }}",
{% endfor %}
]);

// Phase 9 D-03: variable auth header regex catches custom headers like
// `X-Custom-Token`, `X-Service-Auth`, `X-Whatever-Secret` without enumerating
// them ahead of time.
const VARIABLE_AUTH_HEADER_RE = /^x-.*-(auth|token|key|secret)$/i;

// Phase 9 D-03: free-form sensitive string patterns applied to `event.message`.
const SENSITIVE_STRING_PATTERNS: ReadonlyArray<RegExp> = [
  /Bearer\s+\S+/g,
  /sk_live_[A-Za-z0-9]{16,}/g,
  /sk_test_[A-Za-z0-9]{16,}/g,
  /ghp_[A-Za-z0-9]{16,}/g,
  /eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/g,
];

const REDACT_BODY_KEYS = new Set<string>([
{% for k in redact_body_keys %}
  "{{ k }}",
{% endfor %}
]);

const REDACTED = "[Redacted by mcpgen]";

/**
 * Sentry `beforeSend` hook — strips sensitive headers + top-level body keys
 * + free-form message string-pattern scrub (Phase 9 D-03).
 *
 * v1 contract: walks `event.request.headers`, `event.request.data`
 * (TOP-LEVEL keys ONLY), `event.breadcrumbs[*].data.http_request_headers`,
 * and `event.message`. Recursive body walk is a Phase 9 follow-up (NOTE 6).
 */
export function redactSensitive(event: ErrorEvent, _hint: EventHint): ErrorEvent | null {
  const req = event.request;
  if (req?.headers) {
    for (const k of Object.keys(req.headers)) {
      const lk = k.toLowerCase();
      if (REDACT_HEADERS.has(lk) || VARIABLE_AUTH_HEADER_RE.test(lk)) {
        req.headers[k] = REDACTED;
      }
    }
  }
  // top_level_only — see NOTE 6 above re Phase 9 recursive walker.
  if (req?.data && typeof req.data === "object" && req.data !== null) {
    const data = req.data as Record<string, unknown>;
    for (const k of Object.keys(data)) {
      if (REDACT_BODY_KEYS.has(k.toLowerCase())) {
        data[k] = REDACTED;
      }
    }
  }
  if (event.breadcrumbs) {
    for (const b of event.breadcrumbs) {
      const bd = b.data as { http_request_headers?: Record<string, unknown> } | undefined;
      const headers = bd?.http_request_headers;
      if (headers) {
        for (const k of Object.keys(headers)) {
          const lk = k.toLowerCase();
          if (REDACT_HEADERS.has(lk) || VARIABLE_AUTH_HEADER_RE.test(lk)) {
            headers[k] = REDACTED;
          }
        }
      }
    }
  }
  // Phase 9 D-03: scrub free-form message string for Bearer / sk_*/ ghp_ / JWT.
  if (typeof event.message === "string") {
    let m = event.message;
    for (const re of SENSITIVE_STRING_PATTERNS) {
      m = m.replace(re, REDACTED);
    }
    event.message = m;
  }
  return event;
}
