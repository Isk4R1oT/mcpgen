// Generated by mcpgen — Stage E Phase 3 (runtime/truncation.ts).
//
// Per CONTEXT D-07: frozen per-tool-type truncation thresholds + teaching
// templates. Mirrors `apps/generation-engine/src/mcpgen_engine/passes/pass_5/
// templates.py::TRUNCATION_TEMPLATES` verbatim — both Python (Pass 5
// validation) and TypeScript (runtime enforcement) consume the same table.
//
// Pitfall #5 invariant: every template contains the anti-loop wording
// ("usually sufficient" or "only paginate if the user explicitly requested
// all"); `search` row NEVER mentions next_cursor / cursor / paginate.
//
// Substitution placeholders (filled by `applyTruncation` at runtime):
//   {N}                  count shown
//   {Total}              total count
//   {Total_minus_N}      remaining count
//   {cursor_value}       opaque cursor for list_objects continuation
//   {offset_value}       integer offset for list_objects continuation
//   {action}             action / workflow tool name
//   {success_count}      workflow successful sub-step count
//   {total_steps}        workflow total sub-step count
//   {operation}          upsert verb (`create` / `update`)

export interface TruncationRow {
  readonly threshold: number;
  readonly template: string;
}

export const TRUNCATION_TEMPLATES: Readonly<Record<string, TruncationRow>> = Object.freeze({
  search: Object.freeze({
    threshold: 10000,
    template:
      "Showing top {N} results. {Total_minus_N} more matches exist; " +
      "usually sufficient. Refine query for precision.",
  }),
  list_objects: Object.freeze({
    threshold: 15000,
    template:
      "Showing {N} of {Total} objects. {Total_minus_N} more available; " +
      "usually sufficient. To continue, use {cursor: '{cursor_value}'} " +
      "or {offset: {offset_value}}. " +
      "only paginate if the user explicitly requested all.",
  }),
  list_collections: Object.freeze({
    threshold: 10000,
    template: "Showing {N} of {Total} collections; usually sufficient.",
  }),
  fetch: Object.freeze({
    threshold: 20000,
    template:
      "Object has {Total} fields, showing {N} default. " +
      "To see all fields, call fetch again with properties=['*'] or " +
      "specify field names. Default usually sufficient.",
  }),
  upsert: Object.freeze({
    threshold: 5000,
    template:
      "Upsert completed. Returning {N} of {Total} fields of the " +
      "{operation} object; usually sufficient.",
  }),
  delete: Object.freeze({
    threshold: 5000,
    template:
      "Delete completed. Confirmation: {N} of {Total} resources affected. " +
      "Result usually sufficient.",
  }),
  action: Object.freeze({
    threshold: 5000,
    template:
      "Action `{action}` completed. Output truncated at {N} tokens; " +
      "usually sufficient. Use search/fetch to inspect resulting state.",
  }),
  workflow: Object.freeze({
    threshold: 15000,
    template:
      "Workflow `{action}` completed: {success_count}/{total_steps} " +
      "sub-operations. Truncated to key results; usually sufficient. " +
      "Sub-operation details available via fetch.",
  }),
});

/** Substitution context for `applyTruncation`. */
export interface TruncationContext {
  readonly N?: number;
  readonly Total?: number;
  readonly Total_minus_N?: number;
  readonly cursor_value?: string;
  readonly offset_value?: number;
  readonly action?: string;
  readonly success_count?: number;
  readonly total_steps?: number;
  readonly operation?: string;
}

export interface TruncationResult {
  readonly data: unknown;
  readonly truncated: boolean;
  readonly guidance?: string;
}

function approxTokens(serialized: string): number {
  // Conservative 4 chars/token estimate (matches Pass 5 design Appendix A).
  return Math.ceil(serialized.length / 4);
}

function fillTemplate(template: string, ctx: TruncationContext): string {
  return template.replace(/\{(\w+)\}/g, (_match, key: string) => {
    const v = (ctx as Record<string, unknown>)[key];
    if (v === undefined || v === null) return "{" + key + "}";
    return String(v);
  });
}

/**
 * Apply truncation guidance for a tool-type response body. Returns the
 * (possibly truncated) data plus a teaching guidance string when truncation
 * triggered.
 */
export function applyTruncation(
  toolType: string,
  body: unknown,
  ctx: TruncationContext,
): TruncationResult {
  const row = TRUNCATION_TEMPLATES[toolType];
  if (!row) {
    return { data: body, truncated: false };
  }
  const serialized = JSON.stringify(body);
  const tokens = approxTokens(serialized);
  if (tokens <= row.threshold) {
    return { data: body, truncated: false };
  }
  return {
    data: body,
    truncated: true,
    guidance: fillTemplate(row.template, ctx),
  };
}
