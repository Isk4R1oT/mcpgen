// Generated by mcpgen — Stage E Phase 3 (runtime/capability.ts).
// Pitfall #4 mitigation per CONTEXT D-24: capability-gated outputSchema emission.
//
// Older MCP clients (pre-2025-06-18 spec) reject unknown response fields and
// silently fail to load tools. We gate `outputSchema` (in tools/list) and
// `structuredContent` (in tools/call) on the client `protocolVersion` parsed
// during `initialize` and stashed on session ctx.
//
// MCP protocol versions are date-format strings (YYYY-MM-DD); standard string
// `>=` lex compare gives correct chronological order — no semver dep needed.

export const MIN_OUTPUT_SCHEMA_VERSION = "2025-06-18";

/** Lex compare for YYYY-MM-DD MCP protocol version strings. */
export function gteVersion(a: string, b: string): boolean {
  return a >= b;
}

/**
 * Returns true iff the client `protocolVersion` is >= MIN_OUTPUT_SCHEMA_VERSION.
 *
 * Conservative default: undefined / unparseable client → false (fall back to
 * `content`-only response). Better to under-emit than break older clients.
 */
export function gateOutputSchema(clientVersion: string | undefined): boolean {
  if (!clientVersion) return false;
  return gteVersion(clientVersion, MIN_OUTPUT_SCHEMA_VERSION);
}
