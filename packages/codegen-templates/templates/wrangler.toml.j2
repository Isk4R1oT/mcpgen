# Cloudflare Worker configuration for the {{ spec_slug }} MCP server.
# Generated by mcpgen Stage E (Plan 04-06 scaffold). Phase 6 substitutes the
# `{tenant_short_id}` prefix at deploy time (CONTEXT D-25 — Pitfall #30).
#
# NOTE: this file does NOT call `wrangler namespaces create`. Per
# Phase 1 D-08 + Pitfall #11, dispatch namespaces are environment-scoped
# (one per env: prod / staging / dev), NOT per-tenant.

name = "{{ spec_slug }}-mcp"
main = "src/index.ts"
compatibility_date = "2026-01-01"
compatibility_flags = ["nodejs_compat"]

[vars]
MCP_PROTOCOL_VERSION = "{{ mcp_protocol_version }}"
SPEC_SLUG = "{{ spec_slug }}"
UPSTREAM_BASE_URL = "{{ upstream_base_url }}"

[observability]
enabled = true

{% if auth_mode == "oauth" %}
# OAuth flow tokens (Logto-managed) — Phase 6 wires the Logto tenant.
[[kv_namespaces]]
binding = "OAUTH_KV"
id = "REPLACE_AT_DEPLOY"
{% endif %}
{% if auth_mode == "stored" %}
# Per-tenant DEK for AES-256-GCM upstream-credential storage. Phase 6
# wires the binding ID at deploy time + provisions the DEK.
[[kv_namespaces]]
binding = "TENANT_DEK_KV"
id = "REPLACE_AT_DEPLOY"
{% endif %}
