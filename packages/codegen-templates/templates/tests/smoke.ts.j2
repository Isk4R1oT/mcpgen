// per-tenant smoke test only.

import { describe, expect, test } from "vitest";
import { redactSensitive } from "../src/runtime/sentry_redact.js";

describe("Pitfall #12 — Sentry redaction smoke test", () => {
  test("redactSensitive strips Authorization header", () => {
    const event = {
      request: {
        headers: {
          Authorization: "Bearer sk_live_TEST",
          "Content-Type": "application/json",
        },
      },
    };
    const out = redactSensitive(event as never, {} as never);
    const headers = (out as { request: { headers: Record<string, string> } })
      .request.headers;
    expect(headers["Authorization"]).toBe("[Redacted by mcpgen]");
    // Non-sensitive headers should pass through unchanged.
    expect(headers["Content-Type"]).toBe("application/json");
  });

  test("redactSensitive strips top-level body password / api_key", () => {
    const event = {
      request: {
        data: {
          password: "secret",
          api_key: "xyz",
          public_field: "public-value",
        },
      },
    };
    const out = redactSensitive(event as never, {} as never);
    const data = (out as { request: { data: Record<string, string> } }).request
      .data;
    expect(data["password"]).toBe("[Redacted by mcpgen]");
    expect(data["api_key"]).toBe("[Redacted by mcpgen]");
    expect(data["public_field"]).toBe("public-value");
  });

  test("redactSensitive strips X-Upstream-Auth header", () => {
    const event = {
      request: {
        headers: {
          "X-Upstream-Auth": "Bearer sk_live_OTHER",
        },
      },
    };
    const out = redactSensitive(event as never, {} as never);
    const headers = (out as { request: { headers: Record<string, string> } })
      .request.headers;
    expect(headers["X-Upstream-Auth"]).toBe("[Redacted by mcpgen]");
  });
});
