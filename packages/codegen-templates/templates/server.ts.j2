// MCP server bootstrap for the {{ spec_slug }} Worker.
// Uses MCP SDK v1 — `server.tool(name, description, schema, annotations, cb)`
// 5-arg overload. Phase 1 D-04 invariant: STAY ON v1 (NOT v2 `registerTool`).
// CONTEXT D-22 — DNS-rebinding mitigation rides on
// WebStandardStreamableHTTPServerTransport.{enableDnsRebindingProtection,
// allowedHosts}.
// CONTEXT D-24 — capability negotiation: McpServer's high-level API handles
// `initialize` internally; clientVersion is read from server.server (the
// underlying `Server` instance) via `getClientVersion()` inside per-tool
// handlers when they assemble structuredContent.
//
// Per-tool registration helpers (`registerSearch`, `registerFetch`, etc.)
// emitted by Plan 04-10 use the SDK v1 5-arg `tool()` form.
// All tools are wired via registerAllTools() (src/tools/index.ts) which is
// generated by Plan 04-10 tools_index.ts.j2 — DO NOT add per-tool imports
// here (D-1 fix: Plan 04-14).

import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { WebStandardStreamableHTTPServerTransport } from "@modelcontextprotocol/sdk/server/webStandardStreamableHttp.js";
import { registerAllTools } from "./tools/index.js";
import { SERVER_NAME_TEMPLATE, ALLOWED_HOSTS } from "./config.js";

export interface SessionContext {
  clientVersion: string | undefined;
  upstreamCredential: string | undefined;
}

export function createServer(): {
  server: McpServer;
  transport: WebStandardStreamableHTTPServerTransport;
} {
  const server = new McpServer(
    { name: SERVER_NAME_TEMPLATE, version: "1.0.0" },
    { capabilities: { tools: {} } },
  );

  // Register all generated tool handlers in a single call.
  // Plan 04-14 D-1 fix: delegate to registerAllTools (tools/index.ts)
  // instead of inline Jinja2 for-loop — scaffold phase 1 never received
  // final_tools in its render context so the loop always fell through to empty.
  registerAllTools(server);

  // DNS-rebinding mitigation — CONTEXT D-22 + Pattern 4
  // Rides on WebStandardStreamableHTTPServerTransport native
  // `enableDnsRebindingProtection` (CVE-2025-66414 fix landed in MCP SDK
  // 1.24.0; we're pinned ^1.29.0). The Web-Standard variant is the right
  // transport for CF Workers (handleRequest takes a `Request` and returns
  // a `Response`, unlike the Node-flavoured `StreamableHTTPServerTransport`).
  const transport = new WebStandardStreamableHTTPServerTransport({
    // Stateless mode (SDK webStandardStreamableHttp.d.ts:46) — required for
    // CF Workers: per-request isolates discard in-memory session state.
    // CONTEXT 04-PHASE-DEVIATIONS D-2.
    sessionIdGenerator: undefined,
    enableDnsRebindingProtection: true,
    allowedHosts: ALLOWED_HOSTS,
    allowedOrigins: ALLOWED_HOSTS.map((h) => `https://${h}`),
  });
  return { server, transport };
}
