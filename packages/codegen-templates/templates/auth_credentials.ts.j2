{% if auth_mode == "passthrough" %}
// Passthrough mode: credentials live entirely in the request header.
// No persistence, no encryption — credentials are forwarded directly to the
// upstream API. T-04-09-passthrough-creds-persist mitigation: nothing here
// touches KV, caches, localStorage, or sessionStorage.

export function extractCredential(req: Request): string | null {
  return req.headers.get("X-Upstream-Auth");
}
{% elif auth_mode == "stored" %}
// Stored mode: AES-256-GCM via crypto.subtle (CF Workers Web Crypto).
// Per-tenant DEK lives in TENANT_DEK_KV (binding declared in wrangler.toml).
// Phase 6 wires the deploy-time DEK provisioning + initial credential
// encryption; Phase 4 emits the runtime helpers.

const _IV_LENGTH = 12;

/**
 * Decrypt an AES-256-GCM ciphertext encoded as base64.
 *
 * Layout: first 12 bytes = IV; remainder = AES-GCM ciphertext + tag.
 * The DEK is a raw 32-byte ArrayBuffer fetched from `TENANT_DEK_KV`.
 */
export async function decryptCredential(
  encryptedBase64: string,
  dek: ArrayBuffer,
): Promise<string> {
  const raw = Uint8Array.from(atob(encryptedBase64), (c) => c.charCodeAt(0));
  const iv = raw.slice(0, _IV_LENGTH);
  const ciphertext = raw.slice(_IV_LENGTH);
  const key = await crypto.subtle.importKey(
    "raw",
    dek,
    { name: "AES-GCM" },
    false,
    ["decrypt"],
  );
  const plain = await crypto.subtle.decrypt(
    { name: "AES-GCM", iv },
    key,
    ciphertext,
  );
  return new TextDecoder().decode(plain);
}

/**
 * Encrypt a plaintext credential with AES-256-GCM and return base64.
 *
 * The 12-byte IV is generated per-call via `crypto.getRandomValues` and
 * prepended to the ciphertext. Phase 6 calls this helper at deploy time
 * when the operator first provides the upstream credential.
 */
export async function encryptCredential(
  plaintext: string,
  dek: ArrayBuffer,
): Promise<string> {
  const iv = crypto.getRandomValues(new Uint8Array(_IV_LENGTH));
  const key = await crypto.subtle.importKey(
    "raw",
    dek,
    { name: "AES-GCM" },
    false,
    ["encrypt"],
  );
  const ciphertext = await crypto.subtle.encrypt(
    { name: "AES-GCM", iv },
    key,
    new TextEncoder().encode(plaintext),
  );
  const out = new Uint8Array(_IV_LENGTH + ciphertext.byteLength);
  out.set(iv);
  out.set(new Uint8Array(ciphertext), _IV_LENGTH);
  let binary = "";
  for (const byte of out) {
    binary += String.fromCharCode(byte);
  }
  return btoa(binary);
}
