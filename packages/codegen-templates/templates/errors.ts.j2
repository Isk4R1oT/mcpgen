// Generated by mcpgen — Stage E Phase 3 (runtime/errors.ts).
//
// Per CONTEXT D-32 (Anthropic principle "errors teach the agent next step"):
// every upstream-failure path returns a teaching message that points the
// agent at the next concrete action.
//
//   401 / 403 → "Verify X-Upstream-Auth header is set with a valid token..."
//   404       → "Use search() to locate by query, then fetch() with the
//                returned smart ID."
//   429       → "Retry after {retry_after}s. Batch operations where possible."
//   422 / 400 → "Common issue: check parameter format and required fields."
//   5xx       → "Upstream service error. The server is temporarily
//                unavailable; retry after {retry_after_default}s."

import { UpstreamError } from "./upstream.js";

const DEFAULT_RETRY_AFTER_S = 30;

// Mutable shape required by the SDK's CallToolResult schema; the SDK's Zod
// `tool()` callback signature expects mutable `content[]` AND the SDK
// `CallToolResultSchema` is defined with `z.object({...}).$loose` which
// adds an `[x: string]: unknown` index signature. We mirror the index
// signature so structural assignment to the SDK callback's return type
// succeeds without an explicit cast.
export interface McpErrorResponse {
  [k: string]: unknown;
  isError: true;
  content: Array<{ type: "text"; text: string }>;
}

/**
 * Map an upstream failure (or any thrown error) to an MCP error response
 * with teaching guidance per CONTEXT D-32.
 *
 * Non-`UpstreamError` exceptions surface as an internal-error message
 * with the tool name — F1 (Phase 5) rejects servers that swallow errors
 * silently or return non-MCP shapes.
 */
export function handleUpstreamError(err: unknown, toolName: string): McpErrorResponse {
  if (!(err instanceof UpstreamError)) {
    return {
      isError: true,
      content: [
        {
          type: "text",
          text: `Internal error in ${toolName}: ${String(err)}`,
        },
      ],
    };
  }
  let msg: string;
  if (err.status === 401 || err.status === 403) {
    msg =
      `Upstream auth failed for ${toolName}. ` +
      "Verify X-Upstream-Auth header is set with a valid token; " +
      "consult the deployed server README for credential setup.";
  } else if (err.status === 404) {
    msg =
      "Resource not found. " +
      "Use search() to locate by query, then fetch() with the returned smart ID.";
  } else if (err.status === 429) {
    const ra = err.retry_after ?? DEFAULT_RETRY_AFTER_S;
    msg =
      `Rate-limited by upstream. Retry after ${ra}s. ` +
      "To reduce request volume, batch operations where possible.";
  } else if (err.status === 422 || err.status === 400) {
    msg =
      `Upstream rejected the request: ${err.body.slice(0, 200)}. ` +
      "Common issue: check parameter format and required fields.";
  } else if (err.status >= 500) {
    const ra = err.retry_after ?? DEFAULT_RETRY_AFTER_S;
    msg =
      `Upstream service error (${err.status}). ` +
      `The server is temporarily unavailable; retry after ${ra}s.`;
  } else {
    msg = `Upstream error ${err.status}: ${err.body.slice(0, 200)}`;
  }
  return {
    isError: true,
    content: [{ type: "text", text: msg }],
  };
}
