// Generated by mcpgen — Stage E Phase 5 (src/tools/{{ tool.name }}.ts).
// Tool type: workflow — per-tool instantiation.
//
// Sequential step execution with partial-failure handling per Stage E
// design §4.4 + CONTEXT D-31. Steps are taken from Pass 1
// `Workflow.steps` and rendered into the source-endpoints array; each
// step calls upstream sequentially and partial successes are surfaced
// in the response.
//
// Conservative-aggregation error message per Pass 4 invariant: when a
// step fails, the response makes the partial state explicit and points
// the agent at search/fetch to inspect.
//
// MCP SDK v1 5-arg form per Phase 1 D-04 invariant.

import { z } from "zod";
import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { upstreamRequest, UpstreamError } from "../runtime/upstream.js";
import { assembleStructuredContent } from "../runtime/response_shaping.js";
import { applyTruncation } from "../runtime/truncation.js";
import { handleUpstreamError } from "../runtime/errors.js";
import { routing } from "../schemas/routing.js";
import { UPSTREAM_BASE_URL } from "../config.js";

interface WorkflowStepResult {
  readonly endpoint: string;
  readonly status: "success" | "failed" | "skipped";
  readonly data?: unknown;
  readonly error?: string;
}

const _ROUTING_KEY_PREFIX = "workflow:";

export function {{ register_function_name }}(server: McpServer): void {
  // SDK v1 registerTool(name, config, cb) — accepts outputSchema per mcp.d.ts:150-157
  server.registerTool(
    {{ tool.name | tojson }},
    {
      description: {{ tool.description_text | tojson }},
      inputSchema: z.object({
        payload: z
          .record(z.string(), z.unknown())
          .optional()
          .describe(
            "Workflow input — forwarded to each step's request body.",
          ),
      }).shape,
      outputSchema: {{ tool.output_schema | json_schema_to_zod }},
      annotations: {{ tool.annotations | tojson }},
    },
    async (args, extra) => {
      try {
        const ctx = (extra as {
          _ctx?: { clientVersion?: string; upstreamCredential?: string };
        })._ctx ?? {};
        const stepResults: WorkflowStepResult[] = [];
        let firstFailureIndex: number | null = null;

{% set total_steps = tool.source_endpoints | length %}
{% for source_endpoint in tool.source_endpoints %}
        {
          const stepIndex = {{ loop.index0 }};
          const stepEndpoint = {{ source_endpoint | tojson }};
          if (firstFailureIndex !== null) {
            stepResults.push({ endpoint: stepEndpoint, status: "skipped" });
          } else {
            const routeKey = _ROUTING_KEY_PREFIX + stepEndpoint;
            const route = routing[routeKey];
            if (route === undefined) {
              firstFailureIndex = stepIndex;
              stepResults.push({
                endpoint: stepEndpoint,
                status: "failed",
                error: "routing not configured for this step",
              });
            } else {
              try {
                const upstream = await upstreamRequest(
                  {
                    method: route.method,
                    path: route.path,
                    ctx,
                    body: args.payload,
                  },
                  UPSTREAM_BASE_URL,
                );
                stepResults.push({
                  endpoint: stepEndpoint,
                  status: "success",
                  data: upstream,
                });
              } catch (err) {
                firstFailureIndex = stepIndex;
                const message =
                  err instanceof UpstreamError
                    ? `Upstream ${err.status}: ${err.body.slice(0, 200)}`
                    : String(err);
                stepResults.push({
                  endpoint: stepEndpoint,
                  status: "failed",
                  error: message,
                });
              }
            }
          }
        }
{% endfor %}

        const successCount = stepResults.filter((r) => r.status === "success")
          .length;
        const totalSteps = {{ total_steps }};

        if (firstFailureIndex !== null) {
          return {
            isError: true,
            content: [
              {
                type: "text" as const,
                text:
                  "Workflow failed at step " +
                  String(firstFailureIndex + 1) +
                  " of " +
                  String(totalSteps) +
                  "; partial state may exist — use search/fetch to inspect.",
              },
            ],
          };
        }

        const truncated = applyTruncation(
          "workflow",
          { steps: stepResults },
          {
            action: {{ tool.name | tojson }},
            success_count: successCount,
            total_steps: totalSteps,
          },
        );
        const payload =
          truncated.truncated && truncated.guidance
            ? {
                workflow: {{ tool.name | tojson }},
                success_count: successCount,
                total_steps: totalSteps,
                steps: truncated.data,
                _truncation_guidance: truncated.guidance,
              }
            : {
                workflow: {{ tool.name | tojson }},
                success_count: successCount,
                total_steps: totalSteps,
                steps: truncated.data,
              };
        return assembleStructuredContent(payload, ctx.clientVersion);
      } catch (err) {
        return handleUpstreamError(err, {{ tool.name | tojson }});
      }
    },
  );
}
