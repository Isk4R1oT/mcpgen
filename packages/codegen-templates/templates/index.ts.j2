// Worker entry point for the {{ spec_slug }} MCP server.
// Wraps the request handler with Sentry per @sentry/cloudflare 10.x.
// CONTEXT D-23 — `beforeSend` redaction (Pitfall #12) is mandatory.
//
// Generated by mcpgen Stage E (Plan 04-06 scaffold). The actual MCP server
// + transport are constructed in `./server.ts`. The auth middleware lives
// in `./auth/middleware.ts` (Plan 04-09).

import { withSentry } from "@sentry/cloudflare";
import { redactSensitive } from "./runtime/sentry_redact.js";
import { createServer } from "./server.js";
import { authMiddleware } from "./auth/middleware.js";
import { ALLOWED_HOSTS } from "./config.js";

export interface Env {
  SENTRY_DSN?: string;
{% if auth_mode == "stored" %}
  TENANT_DEK_KV: KVNamespace;
{% endif %}
{% if auth_mode == "oauth" %}
  OAUTH_KV: KVNamespace;
{% endif %}
  USAGE_QUEUE?: Queue<unknown>;
}

const sentryEnvCallback = (env: Env) => ({
  // Phase 4 ships with empty DSN (Phase 9 fills via `.env`); withSentry
  // tolerates an empty DSN and degrades to a no-op tracer.
  dsn: env.SENTRY_DSN ?? "",
  beforeSend: redactSensitive,
  sendDefaultPii: false,
  tracesSampleRate: 0,
});

const handler: ExportedHandler<Env> = {
  async fetch(req: Request, env: Env, _ctx: ExecutionContext): Promise<Response> {
    // ALLOWED_HOSTS is enforced at the SDK transport layer
    // (WebStandardStreamableHTTPServerTransport.allowedHosts in `server.ts`);
    // this import keeps the value in scope so the bundler can tree-shake
    // correctly.
    void ALLOWED_HOSTS;

    // Both `Env` and `AuthEnv` carry only optional fields, so TS2559 fires
    // on the structural intersection check despite the values being
    // runtime-compatible. Cast through `unknown` to assert the intent.
    const auth = await authMiddleware(req, env as unknown as Parameters<typeof authMiddleware>[1]);
    if (auth.response) return auth.response;

    const { server, transport } = createServer();
    await server.connect(transport);
    // WebStandardStreamableHTTPServerTransport.handleRequest(Request)
    // returns Promise<Response> directly — the right shape for CF Workers.
    return transport.handleRequest(req);
  },
};

// `withSentry`'s default Env generic is `typeof cloudflareEnv` from
// `cloudflare:workers`, which has no shared fields with our hand-rolled
// Env interface (TS2559 intersection-shape mismatch). Cast through
// `unknown` so the union check sees a freshly-typed handler that matches
// the inferred withSentry generic.
export default withSentry(
  sentryEnvCallback as Parameters<typeof withSentry>[0],
  handler as unknown as Parameters<typeof withSentry>[1],
);
