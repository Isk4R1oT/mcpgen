{
  "input_schemas": {
    "search": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "GitHub search qualifier string (e.g. 'is:issue label:bug repo:octocat/Hello-World')."
        }
      },
      "additionalProperties": false,
      "required": ["query"]
    },
    "fetch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Smart-id of form github-v3-rest-api:{type}:{collection}:{identifier}.",
          "pattern": "^github\\-v3\\-rest\\-api:(object|collection):(Issue|PullRequest|Release):[a-zA-Z0-9_-]+$"
        }
      },
      "additionalProperties": false,
      "required": ["id"]
    },
    "list_collections": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Optional substring filter on collection names (case-insensitive)."
        }
      },
      "additionalProperties": false
    },
    "list_objects": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string",
          "description": "Collection name to enumerate.",
          "enum": ["Issue", "PullRequest", "Release"]
        },
        "owner": {
          "type": "string",
          "description": "Repository owner (login or organisation name)."
        },
        "repo": {
          "type": "string",
          "description": "Repository name (without the owner prefix)."
        },
        "limit": {
          "type": "integer",
          "description": "Page size (default 25, max 100).",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        },
        "cursor": {
          "type": "string",
          "description": "Page-number cursor (1-based string). Omit for first page."
        }
      },
      "additionalProperties": false,
      "required": ["collection", "owner", "repo"]
    },
    "upsert": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "description": "Repository owner (login or organisation name)."
        },
        "repo": {
          "type": "string",
          "description": "Repository name (without the owner prefix)."
        },
        "data": {
          "type": "object",
          "description": "Object payload (issue title/body, PR title+head+base, or release tag_name+name)."
        }
      },
      "additionalProperties": false,
      "required": ["owner", "repo", "data"]
    },
    "delete": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "description": "Repository owner."
        },
        "repo": {
          "type": "string",
          "description": "Repository name."
        },
        "id": {
          "type": "string",
          "description": "Smart-id of the release to delete.",
          "pattern": "^github\\-v3\\-rest\\-api:(object|collection):(Issue|PullRequest|Release):[a-zA-Z0-9_-]+$"
        }
      },
      "additionalProperties": false,
      "required": ["owner", "repo", "id"]
    },
    "issues_close": {
      "type": "object",
      "properties": {
        "owner": { "type": "string", "description": "Repository owner." },
        "repo": { "type": "string", "description": "Repository name." },
        "issue_number": {
          "type": "integer",
          "description": "Issue number to close.",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "description": "Target state; pass 'closed' to close the issue.",
          "enum": ["closed"]
        }
      },
      "additionalProperties": false,
      "required": ["owner", "repo", "issue_number", "state"]
    },
    "pull_requests_merge": {
      "type": "object",
      "properties": {
        "owner": { "type": "string", "description": "Repository owner." },
        "repo": { "type": "string", "description": "Repository name." },
        "pull_number": {
          "type": "integer",
          "description": "Pull request number to merge.",
          "minimum": 1
        },
        "merge_method": {
          "type": "string",
          "description": "Merge strategy (default merge).",
          "enum": ["merge", "squash", "rebase"],
          "default": "merge"
        }
      },
      "additionalProperties": false,
      "required": ["owner", "repo", "pull_number"]
    },
    "releases_create": {
      "type": "object",
      "properties": {
        "owner": { "type": "string", "description": "Repository owner." },
        "repo": { "type": "string", "description": "Repository name." },
        "data": {
          "type": "object",
          "description": "Release payload; must include tag_name and name."
        }
      },
      "additionalProperties": false,
      "required": ["owner", "repo", "data"]
    },
    "create_pr_from_branch": {
      "type": "object",
      "properties": {
        "owner": { "type": "string", "description": "Repository owner." },
        "repo": { "type": "string", "description": "Repository name." },
        "branch": {
          "type": "string",
          "description": "Source branch name to resolve and use as PR head."
        },
        "base": {
          "type": "string",
          "description": "Target base branch (default 'main').",
          "default": "main"
        },
        "title": {
          "type": "string",
          "description": "PR title."
        }
      },
      "additionalProperties": false,
      "required": ["owner", "repo", "branch", "title"]
    }
  }
}
