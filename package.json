{
  "name": "mcpgen",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:up": "docker compose -f docker-compose.dev.yml up -d --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "dev:docker:nuke": "docker compose -f docker-compose.dev.yml down -v",
    "dev:docker:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:docker:ps": "docker compose -f docker-compose.dev.yml ps",
    "dev:docker:bootstrap-flags": "FLIPT_URL=http://localhost:8090 pnpm --filter @mcpgen/feature-flags bootstrap",
    "sourcemaps:upload": "bash scripts/sourcemaps/upload-all.sh",
    "leak-audit": "tsx scripts/observability/leak-audit.ts",
    "outbox:monitor": "tsx scripts/observability/outbox-depth-monitor.ts",
    "inngest:orphan-audit": "tsx scripts/observability/inngest-orphan-audit.ts",
    "g3:smoke-cf-delete": "tsx apps/api/src/lib/cf-platforms-deploy.smoketest.ts",
    "langfuse:register-models": "tsx scripts/observability/register-langfuse-models.ts",
    "prepare": "if [ -d .git ] && command -v pre-commit >/dev/null 2>&1; then pre-commit install --hook-type pre-commit --hook-type commit-msg || true; fi"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^10.2.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "vitest": "^1.6.0"
  }
}
