{
  "name": "@mcpgen/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": { "mcpgen": "./src/index.ts" },
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests/init*.test.ts ./tests/auto_spawn.test.ts ./tests/inspector*.test.ts && vitest --run ./tests/deploy*.test.ts ./tests/claude-desktop-config.test.ts",
    "lint": "echo \"no lint step in @mcpgen/cli (covered by workspace eslint via pnpm -r lint)\""
  },
  "dependencies": {
    "commander": "^14.0.3",
    "@clack/prompts": "^0.7.0",
    "picocolors": "^1.1.1",
    "ora": "^8.2.0",
    "@mcpgen/contracts": "workspace:*",
    "@mcpgen/ir": "workspace:*",
    "@mcpgen/engine-fixtures": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "eventsource-parser": "^3.0.8",
    "ulid": "^2.4.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mcpgen/shared-config": "workspace:*",
    "typescript": "^6.0.3",
    "@types/bun": "^1.3.0",
    "vitest": "^1.6.0"
  }
}
