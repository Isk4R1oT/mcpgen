# apps/api/.dev.vars.example
#
# Local dev secrets/config for `wrangler dev`. Copy to `.dev.vars` and fill in
# real values. Do NOT commit `.dev.vars` (gitignored). Production values live
# in CF Workers secrets via `wrangler secret put`.
#
# References:
#   - .planning/phases/09.1-anonymous-hero-flow/09.1-CONTEXT.md D-01

# ─── Logto auth (Phase 8 D-01/D-02) ───────────────────────────────────────
LOGTO_ENDPOINT=
LOGTO_BASE_URL=
LOGTO_M2M_RESOURCE_INDICATOR=
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# ─── Stripe billing (Phase 8 D-06..D-08) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ─── Generation engine HTTP endpoint ───────────────────────────────────────
ENGINE_ENDPOINT=

# ─── Sentry error tracking (Phase 9 CTRL-08) ──────────────────────────────
SENTRY_DSN=

# ─── Phase 09.1 D-01: anonymous gate position (config switch, not hardcoded)
# Values: playground (default) | preview | quality | deploy
#
# - playground: most restrictive — only /generate, /jobs, /deploy/ephemeral
#               are anon-allowed; /preview, /quality, /playground all gated.
# - preview:    additionally opens /preview to anon traffic.
# - quality:    additionally opens /quality (preview + quality public).
# - deploy:     most permissive — opens /playground too (preview + quality
#               + playground all public). Gate sits AFTER playground (only
#               /download + /deploy/permanent + /dashboard remain protected).
BFF_ANONYMOUS_GATE=playground

# ─── Phase 09.1 D-02: anonymous rate-limit (1 generation / IP / 24h) ──────
# The anon-rate-limit middleware (apps/api/src/middleware/anon-rate-limit.ts)
# bypasses requests originating from localhost and private RFC1918 ranges so
# `pnpm test`, `pnpm dev`, and CI smoke runs are NEVER throttled. The bypass
# list is hardcoded in `isLocalhostIp()` (see apps/api/src/lib/anon-ip-hash.ts):
#   - 127.0.0.1 (IPv4 loopback)
#   - ::1       (IPv6 loopback)
#   - 192.168.* (RFC1918 home networks)
#   - 10.*      (RFC1918 corp networks)
# 172.16.0.0/12 is intentionally NOT in the bypass list — VPN exit nodes
# commonly land there and we want them subject to the gate.
#
# Production traffic always carries a CF-Connecting-IP set by Cloudflare at
# the edge; that header CANNOT be spoofed by the client (CF strips client-
# supplied versions). In local dev the middleware falls back to
# x-forwarded-for first hop, then to 127.0.0.1.
#
# No env var is required for the bypass. The IP-hash daily-salt rotation
# pattern (D-11) lives in the `app_secrets` table seeded by migration
# 20260501010000_phase09_1_anon_flow.sql; the daily 00:00 UTC rotation is
# wired in plan 09.1-10.
# ─── Phase 09.1 D-03: anon ephemeral CF Workers for Platforms deploy ──────
# Used by apps/api/src/lib/cf-platforms-deploy.ts for the anon ephemeral
# tenant deploy (POST /api/v1/deploy/ephemeral) and the cleanup cron
# (plan 09.1-10). Token MUST have minimum required scopes:
#   - Workers Scripts:Edit  (PUT/DELETE on dispatch/namespaces/mcpgen-prod/*)
# T-9.1-08-05 mitigation: never log; never grant broader scopes.
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ─── Phase 09.1 local-compute mode (per project_local_compute.md) ─────────
# When set to "1", apps/api/src/lib/cf-platforms-deploy.ts short-circuits
# all three functions (deployScript / deleteScript / retagScript) — deploys
# return a localhost stub URL and delete/retag are no-ops. This allows
# Phases 1–9 (including the 09.1 anon flow) to run end-to-end without CF
# credentials. Phase 10 launch enablement removes the deferral and provisions
# the real CF resources.
MCPGEN_LOCAL_COMPUTE=1

# ─── Phase 09.1 D-06 + Pitfall #3 — anon cleanup BetterStack heartbeat ────
# Consumed by apps/api/src/inngest/functions/anon-tenant-cleanup.ts. Pinged
# at the end of every successful run (every 15 min) so BetterStack alerts
# when the cron silently fails (cost-runaway risk: ~$80/day worst case).
#
# Provisioning is a W7 operator action — see
# `docs/runbooks/anon-cleanup-betterstack-alert.md` for the click-path.
# Phases 1–9 run with this var unset; the cron logs a warning and continues
# (D-01 graceful pattern, mirrors BETTERSTACK_OUTBOX_HEARTBEAT_URL).
BETTERSTACK_ANON_CLEANUP_HEARTBEAT_URL=

# ─── POST-09.1 patch — disable anon cache lookup ───────────────────────────
# When set to "1", apps/api/src/routes/v1/generate.ts skips the L1 cache hit
# branch from plan 09.1-06 and always kicks off a fresh engine pipeline.
# Useful for end-to-end live testing of the OpenRouter inference path.
# Anon protection (rate limit + cost cap) provides the spend ceiling.
BFF_DISABLE_ANON_CACHE=0
