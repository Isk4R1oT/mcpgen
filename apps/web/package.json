{
  "name": "@mcpgen/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:fixtures": "MCPGEN_FRONTEND_MODE=fixtures next dev",
    "dev:live": "MCPGEN_FRONTEND_MODE=live next dev",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'apps/web lint: deferred to Plan 07-02 (next lint deprecated in Next 16; will migrate to ESLint CLI per next-lint-to-eslint-cli codemod)'",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:visual": "playwright test --config=playwright.visual-lock.config.ts",
    "preview:fixtures": "MCPGEN_FRONTEND_MODE=fixtures next start"
  },
  "dependencies": {
    "@logto/next": "^4.2.10",
    "@mcpgen/contracts": "workspace:*",
    "@mcpgen/engine-fixtures": "workspace:*",
    "@mcpgen/ir": "workspace:*",
    "@sentry/nextjs": "^10.50.0",
    "@tanstack/react-query": "^5.0.0",
    "eventsource-parser": "^3.0.8",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.0.0",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mcpgen/shared-config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^1.6.0"
  }
}
