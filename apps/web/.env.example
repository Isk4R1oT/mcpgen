# apps/web/.env.example — Phase 7 frontend env contract.
#
# Real values live in apps/web/.env.local (gitignored per Phase-1 D-19).
# Per Phase-1 D-19: NEVER commit real secrets; this file documents the keys only.
#
# How to consume:
#   cp apps/web/.env.example apps/web/.env.local
#   # then fill in values from your password manager / Logto Cloud / Sentry org

# --- Logto (auth, FE-01 + Plan 07-02) -------------------------------------
# Logto Cloud free tier in Phase 1–9; self-host migration deferred to t+3mo.
# Dashboard: https://cloud.logto.io
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=http://localhost:3000
# LOGTO_COOKIE_SECRET — 32+ random bytes, base64url. Generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
LOGTO_COOKIE_SECRET=

# --- Sentry (error tracking + source-map upload, D-29/D-30) ---------------
# Empty in Phase 7; filled in Phase 9 per environment.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Frontend mode (D-14/D-15/D-16) ---------------------------------------
# fixtures: deterministic SSE replay from packages/engine-fixtures (Wave 1 default)
# live:     real BFF + generation-engine (Wave 3 / staging+production)
MCPGEN_FRONTEND_MODE=fixtures

# --- BFF URL (D-15) -------------------------------------------------------
# Phase 7 / Wave 1 — local dev points at the apps/api wrangler-dev port.
# Phase 8 sets the final dispatch domain.
MCPGEN_BFF_URL=http://localhost:8787/api/v1
