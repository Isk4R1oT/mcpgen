# =============================================================================
# MCPGen — Example Environment Variables
# =============================================================================
# This file is COMMITTED to git. It documents the env contract for both local
# development (.env.local) and CI/CD (Phase 10 secret stores).
#
# To run locally:  copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored.
#
# Source: docs/mcpgen-model-and-provider-override.md §6
# =============================================================================


# === Database (Neon Postgres 16 + pgvector + TimescaleDB) =====================
# Pooled — for runtime apps (Hono BFF, FastAPI engine, dispatch worker)
DATABASE_URL=

# Direct (non-pooled) — for drizzle-kit migrate / drizzle-kit push
# (migrations don't work through pgbouncer pooler)
DATABASE_URL_UNPOOLED=


# === LLM provider (OpenRouter — single-model override per docs) ===============
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_MODEL=qwen/qwen3-coder

# Optional OpenRouter analytics headers
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=


# === Cloudflare (Phase 10 deploy targets) =====================================
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=


# === Sentry (Phase 9 wired, DSNs may be empty for local-mode no-op per D-01) ==
SENTRY_DSN_API=
SENTRY_DSN_DISPATCH=
SENTRY_DSN_ENGINE=
SENTRY_DSN_WEB=


# === Sentry source maps (CI-only — DO NOT add to .env.local per Sentry security guidance) ===
# Threat T-9-sourcemaps-01: a leaked SENTRY_AUTH_TOKEN on a developer machine
# grants prod source-map WRITE access. CI provisions these in Phase 10; the
# local-mode `pnpm sourcemaps:upload` orchestrator skips upload when the token
# is absent (see scripts/sourcemaps/upload-all.sh skip guard).
#
# Provisioned in Phase 10 CI; obtain from sentry.io org settings → auth tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_API=
SENTRY_PROJECT_DISPATCH=
SENTRY_PROJECT_WEB=
SENTRY_PROJECT_ENGINE=


# === Langfuse (LLM tracing via OTel) ==========================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_OTLP_ENDPOINT=


# === Inngest (background jobs) ================================================
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=


# === BetterStack (Phase 10 logs + uptime) =====================================
BETTERSTACK_LOGS_TOKEN=
BETTERSTACK_UPTIME_API_KEY=
